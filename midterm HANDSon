# Create Excel File
file = "orders.xlsx"

try:
    wb = op.load_workbook(file)
    ws = wb.active
except:
    wb = op.Workbook()
    ws = wb.active
    ws.append(["Order ID", "Customer Name", "Product", "Quantity", "Price", "Total"])
    wb.save(file)


# Submit Function
def submit():
    cname = cname_entry.get()
    product = product_entry.get()
    qty = int(qty_entry.get())
    price = float(price_entry.get())

    total = qty * price
    order_id = ws.max_row

    ws.append([order_id, cname, product, qty, price, total])
    wb.save(file)

    table.insert("", "end", values=(order_id, cname, product, qty, price, total))


# Delete Function
def delete():
    selected = table.selection()

    if selected:
        table.delete(selected)


# Update Function
def update():
    selected = table.selection()

    if selected:
        table.item(selected, values=(
            table.item(selected)["values"][0],
            cname_entry.get(),
            product_entry.get(),
            qty_entry.get(),
            price_entry.get(),
            int(qty_entry.get()) * float(price_entry.get())
        ))


# Button Commands
submit_btn.config(command=submit)
delete_btn.config(command=delete)
update_btn.config(command=update)


# Run Window
window.mainloop()
