import tkinter as tk
import openpyxl as xl

wb = xl.Workbook()
ws = wb.active

window = tk.Tk()
window.title("Age Calculator")

# FRAME
frame = tk.Frame(window, bg="lightgreen")
frame.pack(padx=10, pady=10)

# NAME ENTRY
tk.Label(frame, text="Name").grid(row=0, column=0)
name_entry = tk.Entry(frame)
name_entry.grid(row=0, column=1)

# BIRTH YEAR ENTRY
tk.Label(frame, text="Birth Year").grid(row=1, column=0)
birth_entry = tk.Entry(frame)
birth_entry.grid(row=1, column=1)

# SAVE FUNCTION
def save():
    name = name_entry.get()
    birth = int(birth_entry.get())

    age = 2026 - birth

    ws.append([name, birth, age])
    wb.save("output.xlsx")

    print("Saved!")

# BUTTON
tk.Button(frame, text="Submit", command=save).grid(row=2, column=0, columnspan=2)

window.mainloop()
